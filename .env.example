# Copy to .env and fill in. Never commit .env.

# Django signing key. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

# true for local development, false anywhere public.
DEBUG=true

# Comma-separated hostnames Django will serve.
ALLOWED_HOSTS=localhost,127.0.0.1

# Public origin used in absolute URLs (Razorpay callback, sitemap, social cards).
SITE_URL=http://127.0.0.1:8000

# Razorpay keys from the dashboard. rzp_test_ keys work before KYC clears.
# Leave both blank to run in "sandbox" mode: checkout completes with a local
# fake payment page so the whole flow can be exercised without an account.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret configured on the Razorpay webhook (Dashboard > Webhooks). Optional.
RAZORPAY_WEBHOOK_SECRET=

# Storefront contact details.
SUPPORT_EMAIL=hello@baynbae.in
SUPPORT_WHATSAPP=
INSTAGRAM_HANDLE=baynbae
